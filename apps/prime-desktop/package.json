{
  "name": "prime-desktop",
  "productName": "Prime Hermes",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop harness for Prime-Hermes: chat-first shell over agents, task DAGs, kernel, graph, and ledger.",
  "author": "Ariadne",
  "type": "module",
  "main": "dist/electron-main.mjs",
  "scripts": {
    "clean": "tsc --build tsconfig.json --clean && tsc --build tsconfig.electron.json --clean",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc --build tsconfig.electron.json && wait-on http://127.0.0.1:5174 && node scripts/bundle-electron-main.mjs --dev && cross-env HERMES_DESKTOP_DEV_SERVER=http://127.0.0.1:5174 electron .",
    "build": "node scripts/write-build-stamp.mjs && vite build && node scripts/bundle-electron-main.mjs",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint src/ electron/",
    "check": "npm run typecheck && npm run lint",
    "builder": "cross-env NODE_OPTIONS=--max-old-space-size=8192 electron-builder",
    "dist": "npm run build && npm run builder",
    "dist:win:nsis": "npm run build && npm run builder -- --win nsis"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "40.10.2",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "electronVersion": "40.10.2",
    "appId": "com.ariadne.prime",
    "productName": "Prime Hermes",
    "executableName": "PrimeHermes",
    "artifactName": "PrimeHermes-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "asar": true,
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "category": "Development",
      "target": ["AppImage", "deb"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Prime Hermes"
    }
  }
}
